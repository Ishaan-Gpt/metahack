{
  "order": 4,
  "label": "Clean UI",
  "line": "Apple-clean interface cards act out every claim; your take shrinks into a card and comes back.",
  "ref": "Daniel ($10 vs $80), instagram.com/p/DXjyhHEkwOV",
  "swatch": ["#ffffff", "#1d1d1f", "#f27c3a"],
  "fundamentals": "full frame; the footage's problems hidden behind white UI: post cards, wide cards with words, the speaker shrunk to a card or top square; bold sans captions with one gold-orange hero word; pills and a cursor tap; clean clicks",
  "chrome": false,
  "grade": { "contrast": 1.12, "saturate": 0.92, "brightness": 0.95, "warm": 0.02 },
  "palette": { "bgTop": "#ffffff", "bgBottom": "#f2f2f4", "hero": "#f6c06e", "heroStroke": "#f27c3a", "small": "#ffffff", "lime": "#f27c3a", "accent": "#f27c3a", "ink": "#1d1d1f", "paper": "#ffffff", "washRgb": "255,255,255", "glowRgb": "246,192,110" },
  "fonts": { "hero": { "family": "Inter", "file": "inter-latin-wght-normal.woff2", "style": "normal" } },
  "layout": {
    "card": { "x": 0, "y": 0, "w": 1080, "h": 1920, "r": 0, "shadowBlur": 0, "shadowY": 0, "shadowColor": "rgba(0,0,0,0)" },
    "caption": { "yFrac": 0.6, "smallSize": 46, "heroSize": 128, "lineGap": 8, "maxWFrac": 0.86 }
  },
  "caption": { "heroFont": "hero", "heroWeight": 800, "heroUpper": true },
  "allow": ["face", "wide", "post", "topsquare", "graphic", "list", "orbit"]
}
